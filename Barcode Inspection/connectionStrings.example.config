<?xml version="1.0" encoding="utf-8"?>
<connectionStrings>
  <add name="QaDatabase"
       providerName="Npgsql"
       connectionString="Host=YOUR_DB_HOST;Username=YOUR_USER;Password=YOUR_PASSWORD;Port=5432;Database=qa_db;Pooling=true;MinPoolSize=0;MaxPoolSize=10;Command Timeout=60;Timeout=30;Keepalive=60;TCP Keepalive=true;TCP Keepalive Time=60;TCP Keepalive Interval=10;Enlist=false;No Reset On Close=true" />
</connectionStrings>
